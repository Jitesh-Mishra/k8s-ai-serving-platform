{
 "uid": "aiserve",
 "title": "AI serving platform",
 "schemaVersion": 39,
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "refresh": "10s",
 "panels": [
  {
   "type": "timeseries",
   "title": "Requests/s by tenant and model",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (tenant, model) (rate(gateway_requests_total{status=~\"2..\"}[30s]))",
     "legendFormat": "{{tenant}} {{model}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "p50 / p99 latency (gateway, ETA)",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.5, sum by (le) (rate(gateway_request_seconds_bucket{model=\"eta\"}[30s])))",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "expr": "histogram_quantile(0.99, sum by (le) (rate(gateway_request_seconds_bucket{model=\"eta\"}[30s])))",
     "legendFormat": "p99",
     "refId": "B"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Error and throttle rate",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (status) (rate(gateway_requests_total{status!~\"2..\"}[30s]))",
     "legendFormat": "{{status}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "ETA replicas (HPA)",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "kube_deployment_status_replicas_available{deployment=\"eta\"}",
     "legendFormat": "available",
     "refId": "A"
    },
    {
     "expr": "kube_horizontalpodautoscaler_status_desired_replicas{horizontalpodautoscaler=\"eta\"}",
     "legendFormat": "desired",
     "refId": "B"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Batch queue depth",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "max by (kind) (batch_queue_depth)",
     "legendFormat": "{{kind}}",
     "refId": "A"
    },
    {
     "expr": "sum(rate(worker_jobs_total[30s]))",
     "legendFormat": "jobs/s",
     "refId": "B"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "LLM tokens/s and replicas",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(llamacpp:tokens_predicted_total[1m]))",
     "legendFormat": "tokens/s",
     "refId": "A"
    },
    {
     "expr": "kube_deployment_status_replicas_available{deployment=\"llm\"}",
     "legendFormat": "replicas",
     "refId": "B"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "CPU cores by service",
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 24,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (container) (rate(container_cpu_usage_seconds_total{namespace=\"ai\",container!=\"\",container!=\"POD\"}[1m]))",
     "legendFormat": "{{container}}",
     "refId": "A"
    }
   ]
  }
 ],
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 }
}